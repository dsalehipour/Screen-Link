{
  "name": "screenlink-certs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "account-key": "node --input-type=module -e \"import acme from 'acme-client'; console.log(await acme.crypto.createPrivateKey())\""
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "fastify": "^5.11.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "typescript": "^7.0.2"
  }
}
